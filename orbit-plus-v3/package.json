    "eslint-plugin-react-refresh": "^0.4.25",
    "postcss": "^8.4.47",
    "sass": "^1.97.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vite-bundle-visualizer": "^1.2.1",
