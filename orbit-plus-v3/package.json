    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lenis": "^1.3.16",
    "leva": "^0.9.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.13.1",
    "react-use-measure": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "three": "^0.169.0",
    "tone": "^15.0.4",
    "uuid": "^10.0.0",
    "valtio": "^2.2.0",
    "zustand": "^5.0.9"
